-- Replace placeholders with numeric keys returned by sample selectors in this run.
WITH events AS (SELECT school_uid,course_id,activity_id,COUNT(1) AS event_n FROM eo_pdviews.dwd_acitive_user_lms_action_details_di_view WHERE dt>='2026-09-05' AND dt<='2026-09-11' AND event_time>=1788537600 AND event_time<1789142400 AND school_uid IN ({{sample_institution_ids}}) AND role='student' AND action IN ('class_join','handin_homework','handin_exam','looked_activity','join_discuss','handin_answer','handin_clock','en_read_aloud_submit') GROUP BY school_uid,course_id,activity_id)
SELECT a.school_uid,a.course_id,a.category_id,COUNT(1) AS activity_n,SUM(CASE WHEN a.biz_type=1 THEN 1 ELSE 0 END) AS lesson_n,SUM(CASE WHEN a.biz_type=2 THEN 1 ELSE 0 END) AS homework_n,SUM(CASE WHEN a.biz_type=3 THEN 1 ELSE 0 END) AS exam_n FROM eo_pdviews.ods_ms_eo_oslms_lms_activity_df_view a LEFT JOIN events e ON a.school_uid=e.school_uid AND a.course_id=e.course_id AND a.id=e.activity_id WHERE a.dt='2026-09-11' AND a.school_uid IN ({{sample_institution_ids}}) AND a.is_deleted=0 AND a.publish_flag=2 AND a.biz_type BETWEEN 1 AND 15 AND ((a.biz_type=1 AND a.start_time>=1788537600 AND a.start_time<1789142400) OR (a.biz_type<>1 AND ((a.start_time>=1788537600 AND a.start_time<1789142400) OR (a.end_time>=1788537600 AND a.end_time<1789142400) OR e.activity_id IS NOT NULL))) GROUP BY a.school_uid,a.course_id,a.category_id ORDER BY a.school_uid,a.course_id,a.category_id LIMIT 2000;
