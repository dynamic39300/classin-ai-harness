# Server-side only. Never use a VITE_ prefix for credentials.
DEEPSEEK_API_KEY=
# Public Web port for the packaged online demo.
PORT=4173
# Optional official-compatible endpoint override:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional Node 22.19+ / 24+ executable when the default Node is older:
# TEACHBUDDY_NODE=/absolute/path/to/node
